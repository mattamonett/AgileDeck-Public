# Copy to .env and edit. Docker Compose reads this file automatically, and it
# holds passwords, so keep it private: chmod 600 .env

# HTTPS for a public site. Point DNS for your domain at this computer, open
# ports 80 and 443, and uncomment both lines. The bundled Caddy container then
# gets and renews a certificate, and the site address becomes https://DOMAIN.
# DOMAIN=poker.example.com
# COMPOSE_PROFILES=https

# Signs visitor cookies. Leave it unset and the API generates one on first
# start and keeps it in the poker_data volume. To manage it yourself, set a long
# random value, for example the output of: openssl rand -base64 48
# COOKIE_SIGNING_SECRET=
# Optional during rotation: the previous secret, accepted only to verify cookies.
# COOKIE_SIGNING_SECRET_PREVIOUS=

# The site password, at least 8 characters. Needed only when
# access.passwordProtects in config/site.json is "room-creation" or "everything".
# SITE_PASSWORD=

# The admin page at /admin (feedback review, rooms, usage) is off until this is
# set. Anyone who knows it can read private feedback and delete rooms and
# users, so use a long random value of at least 16 characters, for example the
# output of: openssl rand -base64 24. A shorter or guessable value (repeated
# characters, or words like "password" or "admin") stops the API at startup.
# ADMIN_PASSWORD=

# The address people type to reach the site, with no trailing slash.
# Separate several with commas. Defaults to https://DOMAIN when DOMAIN is set,
# otherwise http://localhost:8080.
# POKER_FRONTEND_URL=http://localhost:8080

# Where the web container listens on this computer. Keep 127.0.0.1 and use
# DOMAIN above (or your own HTTPS proxy) for other machines. WEB_BIND=0.0.0.0
# serves plain HTTP to the network, which sends passwords unencrypted; use it
# only on a network you trust.
# WEB_BIND=127.0.0.1
# WEB_PORT=8080

# Reverse proxies allowed to report the visitor's address in X-Forwarded-For,
# as addresses or CIDR ranges. The default trusts only the bundled web and
# Caddy containers. If your own proxy (Caddy, nginx, Traefik) runs on this computer
# and connects to WEB_PORT, add the Docker gateway too. An entry that is not an
# address or range stops the API at startup.
# TRUSTED_PROXY_IPS=172.30.0.10,172.30.0.20,172.30.0.1

# The private Docker network and the web and Caddy containers' addresses on it.
# Change all three together if 172.30.0.0/24 clashes with another network on
# this computer; the trusted proxy default and the Docker gateway (the .1
# address) follow.
# POKER_SUBNET=172.30.0.0/24
# POKER_WEB_IP=172.30.0.10
# POKER_CADDY_IP=172.30.0.20

# Secure cookies are on when every POKER_FRONTEND_URL uses https. Set this to
# true or false to override; any other value stops the API at startup.
# COOKIE_SECURE=

# Socket connections without an Origin header are refused in production.
# true or false; any other value stops the API at startup.
ALLOW_MISSING_SOCKET_ORIGIN=false

# API logging: error, warn, info or debug, and text or json (one JSON object
# per line, for log collectors).
# LOG_LEVEL=info
# LOG_FORMAT=text
